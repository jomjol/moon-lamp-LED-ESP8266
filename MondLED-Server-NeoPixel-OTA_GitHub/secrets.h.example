// Template for the local credentials file.
//
// 1. Copy this file to "secrets.h" (same folder).
// 2. Replace the placeholder values with your own.
// "secrets.h" is listed in .gitignore and must never be committed.

#ifndef _MONDLED_SECRETS_H
#define _MONDLED_SECRETS_H

#define SECRET_WIFI_SSID      "your-wifi-name"
#define SECRET_WIFI_PASSWORD  "your-wifi-password"

// Password for over-the-air updates (use a different one than your WLAN password)
#define SECRET_OTA_PASSWORD   "choose-an-ota-password"

#endif
