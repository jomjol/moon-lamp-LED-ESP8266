# Template for the local ESPHome secrets.
# Copy to "secrets.yaml" (same folder) and fill in your own values.
# "secrets.yaml" is listed in .gitignore and must never be committed.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# 32-byte base64 key – generate one with:  openssl rand -base64 32
# (or let the ESPHome dashboard generate it)
api_encryption_key: "replace-with-generated-key"

ota_password: "choose-an-ota-password"
ap_password: "choose-a-fallback-hotspot-password"
